{
	// For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
	"version": "2.0.0",
	"tasks": [
		{
			"label": "api: build",
			"type": "shell",
			"command": "npm run build",
			"options": {
				"cwd": "${workspaceFolder}/api"
			},
			"group": "build",
			"problemMatcher": "$tsc"
		},
		{
			"label": "func: host start",
			"type": "shell",
			"command": "func host start",
			"options": {
				"cwd": "${workspaceFolder}/api",
				"env": {
					"languageWorkers__node__arguments": "--inspect=9229"
				}
			},
			"isBackground": true,
			"dependsOn": "api: build",
			"problemMatcher": {
				"owner": "func",
				"pattern": [
					{
						"regexp": "^__(NEVER_MATCH)__$",
						"kind": "file",
						"file": 1,
						"message": 1
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Worker process started and initialized"
				}
			}
		},
		{
			"type": "npm",
			"script": "start",
			"path": "site/",
			"isBackground": true,
			"problemMatcher": {
				"owner": "typescript",
				"pattern": "$tsc",
				"background": {
					"activeOnStart": true,
					"beginsPattern": {
						"regexp": "(.*?)"
					},
					"endsPattern": {
						"regexp": "bundle generation complete"
					}
				}
			}
		},
		{
			"type": "npm",
			"script": "test",
			"path": "site/",
			"isBackground": true,
			"problemMatcher": {
				"owner": "typescript",
				"pattern": "$tsc",
				"background": {
					"activeOnStart": true,
					"beginsPattern": {
						"regexp": "(.*?)"
					},
					"endsPattern": {
						"regexp": "bundle generation complete"
					}
				}
			}
		}
	]
}