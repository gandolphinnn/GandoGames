{
	"name": "gandogames-api",
	"version": "1.0.0",
	"main": "dist/api/src/functions/**/*.js",
	"scripts": {
		"build": "tsc && tsc-alias",
		"start": "npm run build && func start --cors \"*\"",
		"test": "jest",
		"fetch-secrets": "func azure functionapp fetch-app-settings GandoGamesApi && node patch-local-settings.js"
	},
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "node",
		"roots": [
			"<rootDir>/src"
		],
		"testMatch": [
			"**/*.spec.ts",
			"**/*.test.ts"
		],
		"transform": {
			"^.+\\.ts$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.spec.json"
				}
			]
		},
		"moduleNameMapper": {
			"^@gandogames/shared/api$": "<rootDir>/../shared/index",
			"^@gandogames/shared/(.*)$": "<rootDir>/../shared/games/$1"
		}
	},
	"dependencies": {
		"@azure/functions": "^4.0.0",
		"playfab-sdk": "^2.187.251205"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.19.17",
		"jest": "^29.x",
		"ts-jest": "^29.x",
		"tsc-alias": "^1.8.17",
		"typescript": "^5.x"
	}
}
