{
	"name": "gandogames-api",
	"version": "1.0.0",
	"main": "dist/api/src/functions/**/*.js",
	"scripts": {
		"build": "tsc",
		"watch": "tsc -w",
		"start": "tsc && func start",
		"test": "jest"
	},
	"jest": {
		"preset": "ts-jest",
		"testEnvironment": "node",
		"roots": [
			"<rootDir>/src"
		],
		"testMatch": [
			"**/*.spec.ts",
			"**/*.test.ts"
		],
		"transform": {
			"^.+\\.ts$": [
				"ts-jest",
				{
					"tsconfig": "tsconfig.spec.json"
				}
			]
		},
		"moduleNameMapper": {
			"^@gandogames/common/api$": "<rootDir>/../common/index",
			"^@gandogames/common/morra$": "<rootDir>/../common/games/morra",
			"^@gandogames/common/pankov$": "<rootDir>/../common/games/pankov"
		}
	},
	"dependencies": {
		"@azure/functions": "^4.0.0",
		"playfab-sdk": "^2.187.251205"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.19.17",
		"jest": "^29.x",
		"ts-jest": "^29.x",
		"typescript": "^5.x"
	}
}
