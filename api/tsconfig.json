{
	"compilerOptions": {
		"module": "node16",
		"target": "ES2022",
		"outDir": "dist",
		"rootDir": "..",
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "node16",
		"sourceMap": true,
		"skipLibCheck": true,
		"types": [ "node", "jest" ],
		"paths": {
			"@gandogames/shared/dto": ["../shared/index"],
			"@gandogames/shared/common": ["../shared/games/common"],
			"@gandogames/shared/*": ["../shared/games/*"],
		}
	}
}